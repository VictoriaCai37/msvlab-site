---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['relative', 'inline-block', className]} id="logo-picker" aria-label="Ms V Lab Logo">
  <!-- Tiny profile: side view, low ponytail, tiny pearl stud -->
  <svg
    class="w-full h-full"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Ms V Lab Logo"
    role="img"
  >
    <defs>
      <linearGradient id="skinGrad" x1="0" y1="0" x2="0" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#fdf6f0"/>
        <stop offset="100%" stop-color="#fceee3"/>
      </linearGradient>
      <linearGradient id="hairGrad" x1="0" y1="0" x2="0" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#3d2b1f"/>
        <stop offset="100%" stop-color="#2d1f15"/>
      </linearGradient>
      <radialGradient id="pearlGrad" cx="50%" cy="30%" r="50%">
        <stop offset="0%" stop-color="#ffffff"/>
        <stop offset="100%" stop-color="#e8e0d8"/>
      </radialGradient>
    </defs>

    <!-- Simplified profile face (facing right) -->
    <path d="M6 24 Q6 14 12 10 Q20 6 28 10 Q30 14 30 24 Q30 28 26 30 Q20 33 14 30 Q8 28 8 24 Q8 18 12 16 Q16 13 22 13 Q26 13 30 16" fill="url(#skinGrad)"/>

    <!-- Eye (profile) - dark brown -->
    <ellipse cx="20" cy="17" rx="1.5" ry="1" fill="#2d1f15"/>

    <!-- Ear (simplified) -->
    <path d="M14 20 Q12 21 12 23 Q13 25 15 25" stroke="#3d2b1f" stroke-width="0.5" fill="none" opacity="0.3"/>

    <!-- Tiny pearl stud -->
    <circle cx="13" cy="23" r="0.7" fill="url(#pearlGrad)"/>

    <!-- Low ponytail -->
    <path d="M18 14 Q14 18 14 24 Q15 28 18 30 Q20 28 22 24 Q22 18 18 14" fill="url(#hairGrad)"/>
    <path d="M24 18 Q26 20 26 24 Q25 27 22 28 Q20 27 20 20" fill="#3d2b1f" opacity="0.6"/>
  </svg>
</div>
