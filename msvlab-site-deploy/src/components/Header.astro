---
import { siteConfig } from '@/data/site';
import LogoPicker from './LogoPicker';
---
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-brand-200">
  <nav class="container-main" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 md:h-14">
      <!-- Logo + Brand -->
      <div class="flex items-center gap-3">
        <LogoPicker class="w-4 h-4 md:w-5 md:h-5" />
        <a href="/" class="font-editorial text-xl md:text-2xl font-medium text-surface-900 hover:text-brand-700 transition-colors whitespace-nowrap">
          {siteConfig.name}
        </a>
        <span class="hidden sm:inline-block w-px h-6 bg-brand-200" aria-hidden="true"></span>
        <span class="hidden sm:inline text-xs text-brand-600 font-medium">{siteConfig.tagline}</span>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-surface-700 hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="md:hidden p-2 rounded-lg text-surface-700 hover:bg-brand-50"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="md:hidden overflow-hidden max-h-0 transition-all duration-300 ease-out">
      <div class="py-4 border-t border-brand-200 flex flex-col gap-1">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2.5 text-sm font-medium text-surface-700 hover:text-brand-700 hover:bg-brand-50 rounded-lg transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Search Trigger (Cmd+K) -->
  <div id="search-trigger" class="fixed bottom-6 right-6 md:hidden z-40" aria-hidden="true">
    <button
      class="btn-primary shadow-lg rounded-full px-4 py-2 gap-2"
      aria-label="Open search (Cmd+K)"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span class="text-xs">Search</span>
    </button>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle
  const menuBtn = document.querySelector('header button[aria-controls="mobile-menu"]');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('max-h-96');
      menuBtn.setAttribute('aria-expanded', isOpen);
    });
  }

  // Cmd+K search shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const searchUI = document.querySelector('search-ui');
      if (searchUI) searchUI.open();
    }
  });
</script>
