---
const searchTranslations = {
  placeholder: 'Search reviews, products, categories…',
  zero_results: 'No results found for "{{query}}"',
  many_results: '{{count}} results for "{{query}}"',
  one_result: '1 result for "{{query}}"',
  filter_placeholder: 'Filter',
  filter_button: 'Filter',
  filter_button_close: 'Close',
  filter_button_clear: 'Clear',
  sort_label: 'Sort by',
  sort_option_relevance: 'Relevance',
  sort_option_date: 'Date',
  sort_option_title: 'Title',
};
---
<div class="search-container">
  <search-ui
    id="search"
    placeholder="Search reviews, products, categories…"
    show-images="true"
    show-empty-filters="false"
    translations={JSON.stringify(searchTranslations)}
  >
    <slot name="trigger" slot="trigger">
      <button
        class="btn-secondary w-full md:w-auto gap-2"
        type="button"
        data-search-ui-trigger
        aria-label="Open search"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden md:inline-flex items-center px-1.5 py-0.5 text-xs bg-surface-100 rounded">⌘K</kbd>
      </button>
    </slot>
  </search-ui>
</div>

<script is:inline>
  // Load Pagefind UI styles and script
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = '/pagefind/pagefind-ui.css';
  document.head.appendChild(link);

  const script = document.createElement('script');
  script.src = '/pagefind/pagefind-ui.js';
  script.onload = () => {
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      excerptLength: 30,
      debounceTimeoutMs: 150,
      showImages: true,
      resetStyles: true,
    });
  };
  document.body.appendChild(script);

  // Keyboard shortcut Cmd/Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const searchUI = document.querySelector('search-ui');
      if (searchUI && typeof searchUI.open === 'function') {
        searchUI.open();
      }
    }
    if (e.key === 'Escape') {
      const searchUI = document.querySelector('search-ui');
      if (searchUI && typeof searchUI.close === 'function') {
        searchUI.close();
      }
    }
  });
</script>

<style>
  /* Pagefind UI customizations */
  search-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-text: #171717;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e5e5;
    --pagefind-ui-tag: #dbeafe;
    --pagefind-ui-tag-text: #1d4ed8;
  }

  @media (prefers-color-scheme: dark) {
    search-ui {
      --pagefind-ui-text: #fafafa;
      --pagefind-ui-background: #171717;
      --pagefind-ui-border: #404040;
      --pagefind-ui-tag: #1e3a8a;
      --pagefind-ui-tag-text: #93c5fd;
    }
  }
</style>
