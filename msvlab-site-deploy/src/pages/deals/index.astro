---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout';
import ProductCard from '@/components/ProductCard';
import { formatDate } from '@/utils/helpers';
import Search from '@/components/Search';
---
<PageLayout title="Deals & Discounts" description="Find the best discounts on tech, smart home, and audio gear. Updated daily with verified deals.">
  <Search />

  {(async () => {
    const allDeals = await getCollection('deals', (entry) => !entry.data.draft);
    const sortedDeals = allDeals.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
    
    return (
      <>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedDeals.map(deal => (
            <article class="card overflow-hidden">
              <a href={`/deals/${deal.slug}`} class="block" aria-label={`View deal: ${deal.data.productName}`}>
                <div class="relative aspect-[4/3] overflow-hidden bg-surface-100">
                  <img src={deal.data.heroImage} alt={deal.data.heroAlt} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
                  <div class="absolute top-3 left-3 flex flex-col gap-1">
                    <span class="badge badge-amber">-{deal.data.discountPercent}%</span>
                    <span class="badge bg-surface-900 text-white text-xs">${deal.data.salePrice.toLocaleString()}</span>
                  </div>
                  <span class="absolute top-3 right-3 badge {deal.data.category === 'smart-home' ? 'badge-smart-home' : deal.data.category === 'computing' ? 'badge-computing' : 'badge-audio'} text-xs">
                    {deal.data.category.charAt(0).toUpperCase() + deal.data.category.slice(1).replace('-', ' ')}
                  </span>
                </div>
                <div class="p-4">
                  <h3 class="font-editorial text-lg font-medium text-surface-900 line-clamp-2 mb-1">{deal.data.productName}</h3>
                  <p class="text-sm text-surface-600 line-clamp-2 mb-3">{deal.data.excerpt}</p>
                  <div class="flex items-center gap-2 text-sm mb-3">
                    <span class="text-surface-900 font-bold">${deal.data.salePrice.toLocaleString()}</span>
                    <span class="text-surface-400 line-through">${deal.data.originalPrice.toLocaleString()}</span>
                    <span class="text-green-600 font-medium">Save ${(deal.data.originalPrice - deal.data.salePrice).toLocaleString()}</span>
                  </div>
                  <div class="flex items-center justify-between text-xs text-surface-500">
                    <span>{deal.data.merchant}</span>
                    <time datetime={deal.data.publishDate}>{formatDate(deal.data.publishDate)}</time>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        {sortedDeals.length === 0 && (
          <div class="text-center py-16">
            <p class="text-surface-600">No active deals at the moment. Check back soon!</p>
          </div>
        )}
      </>
    );
  })()}
</PageLayout>
