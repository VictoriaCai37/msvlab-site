---
import BaseLayout from './BaseLayout';
import { siteConfig } from '@/data/site';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}
const { title, description, ogImage, noIndex } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={ogImage} noIndex={noIndex}>
  <div class="container-main py-8 md:py-12 lg:py-16">
    <header class="mb-10 md:mb-14">
      <h1 class="font-editorial text-3xl md:text-4xl lg:text-5xl font-medium text-surface-900 leading-tight mb-4">{title}</h1>
      {description && <p class="text-lg md:text-xl text-surface-600 max-w-3xl">{description}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>
