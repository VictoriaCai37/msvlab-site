---
interface Props {
  title: string;
  excerpt: string;
  image: string;
  imageAlt: string;
  href: string;
  category: string;
  publishDate: string;
  readTime: string;
  rating?: number;
  featured?: boolean;
}
const { title, excerpt, image, imageAlt, href, category, publishDate, readTime, rating, featured } = Astro.props;
import { formatDate, getImageUrl } from '@/utils/helpers';
import { getCategoryColor } from '@/data/categories';
---
<article class="card group animate-fade-in">
  <a href={href} class="block" aria-label={`Read review: ${title}`}>
    <div class="relative aspect-[4/3] overflow-hidden bg-surface-100">
      <img
        src={getImageUrl(image)}
        alt={imageAlt}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      {featured && (
        <span class="absolute top-3 left-3 badge badge-amber">Featured</span>
      )}
      <span class="absolute top-3 right-3 {getCategoryColor(category)} text-xs font-medium px-2.5 py-1 rounded-full">
        {category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ')}
      </span>
      {rating && (
        <div class="absolute bottom-3 right-3 bg-white/95 backdrop-blur-sm rounded-lg px-2 py-1 flex items-center gap-1 text-sm font-medium text-surface-700">
          <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <span>{rating.toFixed(1)}</span>
        </div>
      )}
    </div>

    <div class="p-4 md:p-5 flex flex-col h-[200px] md:h-auto">
      <div class="flex items-center gap-2 text-xs text-surface-500 mb-2">
        <time datetime={publishDate}>{formatDate(publishDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readTime}</span>
      </div>

      <h3 class="font-editorial text-lg md:text-xl font-medium text-surface-900 line-clamp-2 mb-2 group-hover:text-brand-600 transition-colors">
        {title}
      </h3>

      <p class="text-sm text-surface-600 line-clamp-3 flex-1">{excerpt}</p>

      <div class="mt-3 pt-3 border-t border-surface-100 flex items-center justify-between">
        <span class="text-xs text-surface-500">Read review</span>
        <svg class="w-5 h-5 text-surface-400 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>
</article>
