---
import { siteConfig } from '@/data/site';
---
<header class="w-full max-w-[100vw] bg-[#002b5c] border-b border-[#001f44] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 relative">
    <div class="flex justify-between items-center h-20 relative gap-8">
      <!-- Left: Brand Area (vertical: Logo on top, tagline below) -->
      <div class="flex flex-col items-start justify-center gap-1 flex-shrink-0 min-w-0">
        <a href="/" class="flex items-center gap-2 whitespace-nowrap flex-shrink-0" aria-label="Home">
          <svg class="w-10 h-10 flex-shrink-0" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="20,2 37,12 37,28 20,38 3,28 3,12" stroke="#38bdf8" stroke-width="2" fill="none"/>
          <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-weight="bold" font-size="18" fill="#38bdf8">V</text>
        </svg>
          <span class="text-2xl font-bold text-white hover:text-blue-200 transition-colors whitespace-nowrap flex-shrink-0">
            {siteConfig.name}
          </span>
        </a>
        <span class="hidden lg:block text-xs text-gray-400 font-medium whitespace-nowrap ml-9">
          {siteConfig.tagline}
        </span>
      </div>

      <!-- Right: Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-4 lg:gap-6 flex-shrink-0 relative" aria-label="Main navigation">
        {siteConfig.navigation.map((item) => {
          const isCategory = ['Smart Home', 'Computing', 'Audio'].includes(item.label);
          const isMore = ['About', 'Contact'].includes(item.label);
          
          if (isCategory) return null; // Handled by Categories dropdown
          if (isMore) return null; // Handled by More dropdown
          
          return (
            <a
              href={item.href}
              class="text-base lg:text-lg font-medium text-white hover:text-blue-300 transition-colors whitespace-nowrap px-2 py-1.5 rounded-lg hover:bg-white/5"
            >
              {item.label}
            </a>
          );
        })}
        
        <!-- Categories Dropdown -->
        <div class="relative group">
          <button
            class="text-base lg:text-lg font-medium text-white hover:text-blue-300 transition-colors whitespace-nowrap px-2 py-1.5 rounded-lg hover:bg-white/5 flex items-center gap-1.5"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Categories menu"
          >
            Categories
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1.5 w-48 lg:w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50">
            {siteConfig.navigation
              .filter((item) => ['Smart Home', 'Computing', 'Audio'].includes(item.label))
              .map((item) => (
                <a
                  href={item.href}
                  class="block px-4 py-2.5 text-sm font-medium text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-colors whitespace-nowrap"
                >
                  {item.label}
                </a>
              ))}
          </div>
        </div>

        <!-- More Dropdown (About, Contact) -->
        <div class="relative group">
          <button
            class="text-base lg:text-lg font-medium text-white hover:text-blue-300 transition-colors whitespace-nowrap px-2 py-1.5 rounded-lg hover:bg-white/5 flex items-center gap-1.5"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="More menu"
          >
            More
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full mt-1.5 w-40 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50">
            {siteConfig.navigation
              .filter((item) => ['About', 'Contact'].includes(item.label))
              .map((item) => (
                <a
                  href={item.href}
                  class="block px-4 py-2.5 text-sm font-medium text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-colors whitespace-nowrap"
                >
                  {item.label}
                </a>
              ))}
          </div>
        </div>

      </nav>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 rounded-lg text-white hover:bg-white/10 transition-colors flex-shrink-0"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-btn"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation (hidden by default) -->
    <div id="mobile-menu" class="lg:hidden overflow-hidden max-h-0 transition-all duration-300 ease-out bg-[#002b5c] border-t border-[#001f44] -mx-4 px-4">
      <div class="py-4 flex flex-col gap-1">
        {siteConfig.navigation.map((item) => {
          const isCategory = ['Smart Home', 'Computing', 'Audio'].includes(item.label);
          const isMore = ['About', 'Contact'].includes(item.label);
          
          if (isCategory || isMore) return null; // Handled by dropdowns
          
          return (
            <a
              href={item.href}
              class="px-3 py-3 text-lg font-medium text-white/90 hover:text-white hover:bg-white/10 rounded-lg transition-colors whitespace-nowrap"
            >
              {item.label}
            </a>
          );
        })}
        
        <!-- Mobile Categories Dropdown -->
        <details class="group">
          <summary class="px-3 py-3 text-lg font-medium text-white/90 hover:text-white cursor-pointer flex items-center justify-between list-none">
            Categories
            <svg class="w-5 h-5 text-white/70 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pl-6 py-2 space-y-1 border-l border-white/10">
            {siteConfig.navigation
              .filter((item) => ['Smart Home', 'Computing', 'Audio'].includes(item.label))
              .map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2 text-base font-medium text-white/80 hover:text-white hover:bg-white/5 rounded-lg transition-colors whitespace-nowrap"
                >
                  {item.label}
                </a>
              ))}
          </div>
        </details>

        <!-- Mobile More Dropdown -->
        <details class="group">
          <summary class="px-3 py-3 text-lg font-medium text-white/90 hover:text-white cursor-pointer flex items-center justify-between list-none">
            More
            <svg class="w-5 h-5 text-white/70 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pl-6 py-2 space-y-1 border-l border-white/10">
            {siteConfig.navigation
              .filter((item) => ['About', 'Contact'].includes(item.label))
              .map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2 text-base font-medium text-white/80 hover:text-white hover:bg-white/5 rounded-lg transition-colors whitespace-nowrap"
                >
                  {item.label}
                </a>
              ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('max-h-96');
      menuBtn.setAttribute('aria-expanded', isOpen);
      
      // Toggle icon
      const icon = menuBtn.querySelector('svg');
      if (icon) {
        if (isOpen) {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
        } else {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
        }
      }
    });

    // Close mobile menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('max-h-96');
        menuBtn.setAttribute('aria-expanded', 'false');
        const icon = menuBtn.querySelector('svg');
        if (icon) {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
        }
      });
    });
  }


</script>

<style is:global>
  /* Hide details summary marker */
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary {
    list-style: none;
  }
</style>
