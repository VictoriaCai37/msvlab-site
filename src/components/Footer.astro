---
import { siteConfig } from '@/data/site';
import { categories } from '@/data/categories';
import LogoPicker from './LogoPicker';
---
<footer class="bg-white border-t border-brand-200">
  <div class="container-main py-12 md:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <LogoPicker class="w-4 h-4" />
          <span class="font-editorial text-xl font-medium text-surface-900">{siteConfig.name}</span>
        </div>
        <p class="text-sm text-surface-600 mb-6 leading-relaxed">{siteConfig.description}</p>
        <div class="flex gap-4">
          {Object.entries(siteConfig.social).map(([platform, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={platform} class="text-surface-400 hover:text-brand-600 transition-colors">
              {platform === 'twitter' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
              {platform === 'facebook' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>}
              {platform === 'instagram' && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="2" y="2" width="20" height="20" rx="5" ry="5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>}
              {platform === 'youtube' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>}
            </a>
          ))}
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="font-medium text-surface-900 mb-4 text-brand-900">Categories</h3>
        <ul class="space-y-2 text-sm">
          {categories.map((cat) => (
            <li>
              <a href={cat.href || `/categories/${cat.slug}`} class="text-surface-600 hover:text-brand-700 transition-colors">{cat.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-medium text-surface-900 mb-4 text-brand-900">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/reviews" class="text-surface-600 hover:text-brand-700 transition-colors">All Reviews</a></li>
          <li><a href="/best-products" class="text-surface-600 hover:text-brand-700 transition-colors">Best Products</a></li>
          <li><a href="/deals" class="text-surface-600 hover:text-brand-700 transition-colors">Deals</a></li>
          <li><a href="/about" class="text-surface-600 hover:text-brand-700 transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-surface-600 hover:text-brand-700 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-medium text-surface-900 mb-4 text-brand-900">Legal</h3>
        <ul class="space-y-2 text-sm">
          {siteConfig.footerLinks.legal.map((link) => (
            <li><a href={link.href} class="text-surface-600 hover:text-brand-700 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-brand-200 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-surface-500">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
      <p class="font-medium text-brand-700">Independent reviews. We may earn affiliate commissions.</p>
    </div>
  </div>
</footer>
