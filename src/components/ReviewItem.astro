---
interface Props {
  review: any;
}
const { review } = Astro.props;

const pubDate = new Date(review.data.publishDate);
const year = pubDate.getFullYear();
const monthDay = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const categoryLabels: Record<string, string> = {
  'smart-home': 'Smart Home',
  'computing': 'Computing',
  'audio': 'Audio',
};
const categoryLabel = categoryLabels[review.data.category] ?? review.data.category;
---
<article class="group flex gap-4 p-3 border border-surface-200 rounded-lg hover:border-brand-300 hover:bg-brand-50/50 transition-all duration-200">
  <div class="flex-shrink-0 w-20 text-right text-xs text-surface-500 leading-tight pt-0.5">
    <time dateTime={pubDate.toISOString()}>{year} · {monthDay}</time>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-block px-2 py-0.5 text-xs font-medium text-brand-700 bg-brand-100 rounded-full">{categoryLabel}</span>
      <span class="text-xs text-surface-500">{review.data.readTime}</span>
    </div>
    <h3 class="font-sans text-base md:text-lg font-semibold text-surface-900 group-hover:text-brand-600 transition-colors line-clamp-2">
      <a href={`/reviews/${review.slug}`}>{review.data.title}</a>
    </h3>
    <p class="text-sm text-surface-600 mt-1 line-clamp-2">{review.data.excerpt}</p>
    <div class="flex items-center gap-3 mt-2">
      {review.data.rating ? (
        <span class="flex items-center gap-1 text-sm text-amber-600">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {review.data.rating.toFixed(1)}
        </span>
      ) : null}
      <a href={`/reviews/${review.slug}`} class="text-sm text-brand-600 hover:text-brand-700 font-medium">Read →</a>
    </div>
  </div>
</article>
