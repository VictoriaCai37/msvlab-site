---
import { getCollection } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout';
import { getCategoryColor } from '@/data/categories';
import { getImageUrl } from '@/utils/helpers';
export async function getStaticPaths() {
  const reviews = await getCollection('reviews', (entry) => !entry.data.draft);
  return reviews.map(review => ({
    params: { slug: review.slug },
    props: { review },
  }));
}
interface Props {
  review: any;
}
const { review } = Astro.props;
const { title, excerpt, heroImage, heroAlt, images, category, tags, publishDate, updateDate, readTime, rating, pros, cons, whoShouldBuy, verdict, specs, price, affiliateUrl } = review.data;
---
<ArticleLayout
  title={title}
  excerpt={excerpt}
  heroImage={heroImage}
  heroAlt={heroAlt}
  images={images}
  category={category}
  tags={tags}
  publishDate={publishDate}
  updateDate={updateDate}
  readTime={readTime}
  rating={rating}
  pros={pros}
  cons={cons}
  whoShouldBuy={whoShouldBuy}
  verdict={verdict}
  specs={specs}
  price={price}
  affiliateUrl={affiliateUrl}
  description={excerpt}
  ogImage={getImageUrl(typeof heroImage === 'string' ? heroImage : heroImage.src)}
>
  <slot name="content">
    <!-- Review content is rendered from the MDX file -->
    <div class="prose-custom" set:html={review.rendered?.html || ''} />
  </slot>
</ArticleLayout>
