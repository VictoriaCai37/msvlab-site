---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout';
import Search from '@/components/Search';
---
<PageLayout title="All Reviews" description="Browse all our in-depth product reviews across Smart Home, Computing, and Audio categories.">
  <Search />

  {(async () => {
    const allReviews = await getCollection('reviews', (entry) => !entry.data.draft);
    const sortedReviews = allReviews.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
    
    return (
      <>
        <div class="mb-8">
          <h2 class="font-editorial text-2xl md:text-3xl font-medium text-surface-900 mb-4">All Reviews ({sortedReviews.length})</h2>
        </div>

        {sortedReviews.length === 0 && (
          <div class="text-center py-16">
            <p class="text-surface-600">No reviews published yet.</p>
          </div>
        )}

        {sortedReviews.length > 0 && (
          <div class="space-y-4">
            {sortedReviews.slice(0, 3).map(review => (
              <div class="p-4 border border-surface-200 rounded-lg">
                <h3 class="font-medium text-surface-900">{review.data.title}</h3>
                <p class="text-sm text-surface-600 mt-1">{review.data.excerpt}</p>
                <a href={`/reviews/${review.slug}`} class="text-sm text-brand-600 hover:text-brand-700">Read more</a>
              </div>
            ))}
          </div>
        )}
      </>
    );
  })()}
</PageLayout>
