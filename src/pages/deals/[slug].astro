---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout';
import { formatDate, getImageUrl } from '@/utils/helpers';
import { getCategoryColor } from '@/data/categories';
export async function getStaticPaths() {
  const deals = await getCollection('deals', (entry) => !entry.data.draft);
  return deals.map(deal => ({
    params: { slug: deal.slug },
    props: { deal },
  }));
}
interface Props {
  deal: any;
}
const { deal } = Astro.props;
const { title, excerpt, heroImage, heroAlt, productName, originalPrice, salePrice, discountPercent, category, merchant, affiliateUrl, expiresAt, publishDate, featured } = deal.data;
---
<PageLayout title={title} description={excerpt} ogImage={getImageUrl(typeof heroImage === 'string' ? heroImage : heroImage.src)}>
  <article class="prose-custom lg:prose-lg xl:prose-xl max-w-none">
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge {getCategoryColor(category)}">{category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ')}</span>
        {featured && <span class="badge badge-amber">Featured Deal</span>}
        <span class="badge badge-amber">Save {discountPercent}%</span>
      </div>
      <h1 class="font-editorial text-3xl md:text-4xl font-medium text-surface-900 leading-tight mb-4">{productName}</h1>
      <p class="text-lg text-surface-600 max-w-2xl">{excerpt}</p>
      <div class="flex flex-wrap items-center gap-4 md:gap-6 text-sm text-surface-500 mt-6">
        <time datetime={publishDate}>{formatDate(publishDate)}</time>
        <span>Merchant: <strong class="text-surface-900">{merchant}</strong></span>
        {expiresAt && <span class="text-amber-600">Expires: {formatDate(expiresAt, 'MMM d, yyyy')}</span>}
      </div>
    </header>

    <figure class="mb-8">
      <img src={getImageUrl(typeof heroImage === 'string' ? heroImage : heroImage.src)} alt={heroAlt} class="w-full rounded-xl shadow-lg" loading="eager" />
    </figure>

    <div class="grid md:grid-cols-2 gap-8 mb-10">
      <div class="bg-brand-50 border border-brand-200 rounded-xl p-6">
        <h3 class="font-medium text-brand-900 mb-4">Deal Price</h3>
        <div class="flex items-baseline gap-3 mb-2">
          <span class="text-3xl font-bold text-brand-700">${salePrice.toLocaleString()}</span>
          <span class="text-surface-400 line-through text-xl">${originalPrice.toLocaleString()}</span>
        </div>
        <p class="text-brand-800">You save <strong>${(originalPrice - salePrice).toLocaleString()}</strong> ({discountPercent}% off)</p>
      </div>
      <div class="bg-surface-50 border border-surface-200 rounded-xl p-6">
        <h3 class="font-medium text-surface-900 mb-4">Quick Specs</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between"><dt class="text-surface-500">Category</dt><dd class="text-surface-900 capitalize">{category.replace('-', ' ')}</dd></div>
          <div class="flex justify-between"><dt class="text-surface-500">Merchant</dt><dd class="text-surface-900">{merchant}</dd></div>
          <div class="flex justify-between"><dt class="text-surface-500">Original Price</dt><dd class="text-surface-900 line-through">${originalPrice.toLocaleString()}</dd></div>
          <div class="flex justify-between"><dt class="text-surface-500">Sale Price</dt><dd class="text-surface-900 font-bold text-brand-600">${salePrice.toLocaleString()}</dd></div>
        </dl>
      </div>
    </div>

    <div class="text-center my-10">
      <a href={affiliateUrl} target="_blank" rel="noopener sponsored nofollow" class="btn-primary text-lg px-10 py-4 inline-flex items-center gap-3">
        <span>Get This Deal →</span>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <p class="mt-3 text-sm text-surface-500">Price verified at publish. We may earn a commission.</p>
    </div>

    <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl">
      <p class="text-sm text-amber-800"><strong>Affiliate Disclosure:</strong> We may earn a commission if you purchase through our links, at no extra cost to you. <a href="/affiliate-disclosure" class="underline hover:text-amber-700">Learn more</a>.</p>
    </div>

    <slot name="content">
      <div set:html={deal.rendered?.html || ''} />
    </slot>
  </article>
</PageLayout>
