---
import BaseLayout from '@/layouts/BaseLayout';
import { siteConfig } from '@/data/site';
import { getCollection } from 'astro:content';
import { getImageUrl } from '@/utils/helpers';
import ProductCard from '@/components/ProductCard.astro';
import { formatDate } from '@/utils/helpers';

// Fetch latest review (featured first, then by publishDate)
const allReviews = await getCollection('reviews', ({ data }) => !data.draft);
const sortedReviews = allReviews.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
const latestReview = sortedReviews[0];

// Fetch latest best-products (featured first, then by publishDate)
const allBestProducts = await getCollection('best-products', ({ data }) => !data.draft);
const sortedBestProducts = allBestProducts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
const latestBestProduct = sortedBestProducts[0];
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="relative bg-gradient-to-b from-brand-50 to-white py-16 md:py-24 lg:py-32">
    <div class="container-main">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-sans text-4xl md:text-5xl lg:text-6xl font-medium text-surface-900 leading-snug mb-6 pb-2">
          Expert Reviews for <span class="text-brand-600">Modern Living</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
          We test home appliances, consumer electronics, and smart home devices so you don't have to.
        </p>
        <div class="inline-flex gap-4 justify-center mb-12">
          <a
            href="/reviews"
            class="inline-flex items-center justify-center px-8 py-3 text-lg font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-sm hover:shadow-md"
          >
            Read Latest Reviews
          </a>
          <a
            href="/best-products"
            class="inline-flex items-center justify-center px-8 py-3 text-lg font-medium text-blue-600 bg-white border-2 border-blue-600 rounded-lg hover:bg-blue-50 transition-colors duration-200"
          >
            Best Products
          </a>
        </div>
        
        <!-- Featured Articles Grid -->
        <div class="max-w-4xl mx-auto mt-12">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Latest Review Card -->
            <ProductCard
              title={latestReview?.data.title ?? 'Latest Review'}
              excerpt={latestReview?.data.excerpt ?? ''}
              image={getImageUrl(latestReview?.data.heroImage)}
              imageAlt={latestReview?.data.heroAlt ?? ''}
              href={`/reviews/${latestReview?.slug}`}
              category={latestReview?.data.category ?? 'reviews'}
              publishDate={String(latestReview?.data.publishDate ?? '')}
              readTime={latestReview?.data.readTime ?? ''}
              rating={latestReview?.data.rating}
            />

            <!-- Latest Best Products Card -->
            <ProductCard
              title={latestBestProduct?.data.title ?? 'Latest Best Products'}
              excerpt={latestBestProduct?.data.excerpt ?? ''}
              image={getImageUrl(latestBestProduct?.data.heroImage)}
              imageAlt={latestBestProduct?.data.heroAlt ?? ''}
              href={`/best-products/${latestBestProduct?.slug}`}
              category={latestBestProduct?.data.category ?? 'best-products'}
              publishDate={String(latestBestProduct?.data.publishDate ?? '')}
              readTime={latestBestProduct?.data.readTime ?? ''}
            />
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="container-main pt-6 pb-12 border-t border-surface-200">
  <!-- Latest Reviews section - title removed, padding reduced -->
  </section>

  <!-- Newsletter Section - Optimized -->
  <section class="bg-[#002b5c] py-16">
    <div class="container-main text-center">
      <h2 class="font-sans text-2xl md:text-3xl font-medium text-white mb-4">Never Miss a Review</h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto">Get our latest reviews delivered to your inbox.</p>
      <form class="flex flex-col sm:flex-row gap-4 w-full max-w-lg mx-auto" action="https://formspree.io/f/msvlab" method="POST">
        <input 
          type="email" 
          name="email" 
          placeholder="your@email.com" 
          required 
          class="flex-1 w-full px-4 py-3 rounded-lg text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 transition-all"
        />
        <button 
          type="submit" 
          class="whitespace-nowrap px-6 py-3 font-medium text-white bg-blue-500 rounded-lg hover:bg-blue-600 transition-colors duration-200"
        >
          Subscribe
        </button>
      </form>
      <p class="text-gray-500 text-sm mt-6">No spam. Unsubscribe anytime. <a href="/privacy" class="text-white hover:text-blue-300 underline">Privacy Policy</a></p>
    </div>
  </section>
</BaseLayout>
