---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout';
import ProductCard from '@/components/ProductCard';
import { categories, getCategoryColor } from '@/data/categories';
import { formatDate, getImageUrl } from '@/utils/helpers';
export async function getStaticPaths() {
  return categories.map(cat => ({ params: { cat: cat.slug } }));
}
interface Props {
  params: { cat: string };
}
---
<PageLayout
  title="Category Reviews"
  description="Browse reviews by category"
  ogImage={getImageUrl('/images/og-category.jpg')}
>
  {(async () => {
    const { cat } = Astro.params;
    const category = categories.find(c => c.slug === cat);
    if (!category) throw new Error(`Category ${cat} not found`);
    
    const allReviews = await getCollection('reviews', (entry) => !entry.data.draft && entry.data.category === category.slug);
    const sortedReviews = allReviews.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
    
    return (
      <>
        <header class="mb-10">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge {getCategoryColor(category.slug)}">{category.name}</span>
          </div>
          <h1 class="font-sans text-3xl md:text-4xl lg:text-5xl font-medium text-surface-900 leading-tight mb-4">{category.name} Reviews</h1>
          <p class="text-lg text-surface-600 max-w-2xl">{category.description}</p>
        </header>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedReviews.map(review => (
            <ProductCard
              title={review.data.title}
              excerpt={review.data.excerpt}
              image={getImageUrl(review.data.heroImage)}
              imageAlt={review.data.heroAlt}
              href={`/reviews/${review.slug}`}
              category={review.data.category}
              publishDate={review.data.publishDate}
              readTime={review.data.readTime}
              rating={review.data.rating}
            />
          ))}
        </div>

        {sortedReviews.length === 0 && (
          <div class="text-center py-16">
            <p class="text-surface-600">No reviews in this category yet.</p>
          </div>
        )}
      </>
    );
  })()}
</PageLayout>
