<svg width="1200" height="675" viewBox="0 0 1200 675" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background gradient - studio lighting -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#052e16"/>
      <stop offset="40%" style="stop-color:#064e1b"/>
      <stop offset="100%" style="stop-color:#166534"/>
    </linearGradient>
    
    <!-- Floor reflection gradient -->
    <linearGradient id="floorGrad" x1="0%" y1="50%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#064e1b;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#052e16;stop-opacity:0"/>
    </linearGradient>
    
    <!-- Rim light gradient -->
    <radialGradient id="rimLight" cx="50%" cy="20%" r="60%">
      <stop offset="0%" style="stop-color:#22c55e;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#22c55e;stop-opacity:0"/>
    </radialGradient>
    
    <!-- Soft shadow filter -->
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="4" dy="8" stdDeviation="6" flood-color="#064e1b" flood-opacity="0.4"/>
    </filter>
    
    <!-- Glow filter -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    
    <!-- Subtle noise texture -->
    <filter id="noise" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch" result="noise"/>
      <feBlend in="SourceGraphic" in2="noise" mode="overlay"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bgGrad)"/>
  
  <!-- Rim light / key light simulation -->
  <ellipse cx="600" cy="101.25" rx="720" ry="202.5" fill="url(#rimLight)"/>
  
  <!-- Floor / surface reflection -->
  <rect x="0" y="371.25000000000006" width="1200" height="303.75" fill="url(#floorGrad)"/>
  
  <!-- Subtle vignette -->
  <rect width="1200" height="675" fill="none" stroke="#052e16" stroke-width="360" opacity="0.3" filter="url(#noise)"/>
  
  
    <g transform="translate(600, 337) scale(1.3)">
      <!-- Body -->
      <rect x="-45" y="-80" width="90" height="100" rx="20" fill="#064e1b" filter="url(#shadow)"/>
      <rect x="-40" y="-75" width="80" height="90" rx="16" fill="#166534"/>
      <!-- Fabric texture -->
      <line x1="-35" y1="-70" x2="35" y2="-70" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-67" x2="35" y2="-67" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-64" x2="35" y2="-64" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-61" x2="35" y2="-61" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-58" x2="35" y2="-58" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-55" x2="35" y2="-55" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-52" x2="35" y2="-52" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-49" x2="35" y2="-49" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-46" x2="35" y2="-46" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-43" x2="35" y2="-43" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-40" x2="35" y2="-40" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-37" x2="35" y2="-37" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-34" x2="35" y2="-34" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-31" x2="35" y2="-31" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-28" x2="35" y2="-28" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-25" x2="35" y2="-25" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-22" x2="35" y2="-22" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-19" x2="35" y2="-19" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-16" x2="35" y2="-16" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-13" x2="35" y2="-13" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-10" x2="35" y2="-10" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-7" x2="35" y2="-7" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-4" x2="35" y2="-4" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="-1" x2="35" y2="-1" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="2" x2="35" y2="2" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="5" x2="35" y2="5" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="8" x2="35" y2="8" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="11" x2="35" y2="11" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="14" x2="35" y2="14" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/><line x1="-35" y1="17" x2="35" y2="17" stroke="#064e1b" stroke-width="0.5" opacity="0.1"/>
      <!-- LED ring -->
      <circle cx="0" cy="-20" r="18" fill="none" stroke="#22c55e" stroke-width="3" filter="url(#glow)"/>
      <circle cx="0" cy="-20" r="14" fill="none" stroke="#22c55e" stroke-width="1" opacity="0.4"/>
      <!-- Buttons on top -->
      <circle cx="-18" cy="-65" r="5" fill="#064e1b" filter="url(#shadow)"/>
      <circle cx="0" cy="-65" r="5" fill="#064e1b" filter="url(#shadow)"/>
      <circle cx="18" cy="-65" r="5" fill="#064e1b" filter="url(#shadow)"/>
      <!-- Base -->
      <ellipse cx="0" cy="35" rx="50" ry="8" fill="#064e1b" opacity="0.5"/>
    </g>
  
  
  <!-- Category badge -->
  <rect x="40" y="40" width="140" height="36" rx="18" fill="#064e1b" opacity="0.8" filter="url(#shadow)"/>
  <text x="110" y="66" text-anchor="middle" font-family="system-ui, sans-serif" font-size="16.5375" font-weight="700" fill="#22c55e" letter-spacing="0.5px">
    SMART-HOME
  </text>
  
  <!-- Title (only for hero) -->
  
  
  <!-- Placeholder label -->
  <text x="600" y="635" text-anchor="middle" font-family="system-ui, sans-serif" font-size="23.625000000000004" font-weight="400" fill="#dcfce7" opacity="0.5">
    Detail Image Placeholder
  </text>
  
  <!-- Ms V Lab watermark -->
  <text x="1160" y="645" text-anchor="end" font-family="system-ui, sans-serif" font-size="14.175000000000002" fill="#dcfce7" opacity="0.15">
    Ms V Lab
  </text>
</svg>