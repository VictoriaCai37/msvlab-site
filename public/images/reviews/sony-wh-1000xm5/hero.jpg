<svg width="1200" height="675" viewBox="0 0 1200 675" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background gradient - studio lighting -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a"/>
      <stop offset="40%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#334155"/>
    </linearGradient>
    
    <!-- Floor reflection gradient -->
    <linearGradient id="floorGrad" x1="0%" y1="50%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#0f172a;stop-opacity:0"/>
    </linearGradient>
    
    <!-- Rim light gradient -->
    <radialGradient id="rimLight" cx="50%" cy="20%" r="60%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0"/>
    </radialGradient>
    
    <!-- Soft shadow filter -->
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="4" dy="8" stdDeviation="6" flood-color="#1e293b" flood-opacity="0.4"/>
    </filter>
    
    <!-- Glow filter -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    
    <!-- Subtle noise texture -->
    <filter id="noise" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch" result="noise"/>
      <feBlend in="SourceGraphic" in2="noise" mode="overlay"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bgGrad)"/>
  
  <!-- Rim light / key light simulation -->
  <ellipse cx="600" cy="101.25" rx="720" ry="202.5" fill="url(#rimLight)"/>
  
  <!-- Floor / surface reflection -->
  <rect x="0" y="371.25000000000006" width="1200" height="303.75" fill="url(#floorGrad)"/>
  
  <!-- Subtle vignette -->
  <rect width="1200" height="675" fill="none" stroke="#0f172a" stroke-width="360" opacity="0.3" filter="url(#noise)"/>
  
  
    <g transform="translate(600, 337) scale(1.2)">
      <!-- Headband -->
      <path d="M-80,-40 Q0,-100 80,-40" stroke="#3b82f6" stroke-width="8" fill="none" stroke-linecap="round" filter="url(#shadow)"/>
      <!-- Ear cups -->
      <circle cx="-80" cy="-40" r="35" fill="#1e293b" filter="url(#shadow)"/>
      <circle cx="-80" cy="-40" r="28" fill="#334155"/>
      <circle cx="-80" cy="-40" r="18" fill="#64748b" opacity="0.3"/>
      <circle cx="80" cy="-40" r="35" fill="#1e293b" filter="url(#shadow)"/>
      <circle cx="80" cy="-40" r="28" fill="#334155"/>
      <circle cx="80" cy="-40" r="18" fill="#64748b" opacity="0.3"/>
      <!-- Ear pads detail -->
      <ellipse cx="-80" cy="-40" rx="30" ry="22" fill="none" stroke="#93c5fd" stroke-width="1.5" opacity="0.6"/>
      <ellipse cx="80" cy="-40" rx="30" ry="22" fill="none" stroke="#93c5fd" stroke-width="1.5" opacity="0.6"/>
      <!-- Hinge details -->
      <rect x="-95" y="-50" width="12" height="20" rx="3" fill="#1e293b" filter="url(#shadow)"/>
      <rect x="83" y="-50" width="12" height="20" rx="3" fill="#1e293b" filter="url(#shadow)"/>
    </g>
  
  
  <!-- Category badge -->
  <rect x="40" y="40" width="140" height="36" rx="18" fill="#1e293b" opacity="0.8" filter="url(#shadow)"/>
  <text x="110" y="66" text-anchor="middle" font-family="system-ui, sans-serif" font-size="16.5375" font-weight="700" fill="#3b82f6" letter-spacing="0.5px">
    AUDIO
  </text>
  
  <!-- Title (only for hero) -->
  
  <text x="600" y="595" text-anchor="middle" font-family="system-ui, sans-serif" font-size="37.125" font-weight="700" fill="#e2e8f0" filter="url(#shadow)">
    Sony WH-1000XM5 Review: Still the Noise-Canceling King ...
  </text>
  
  
  <!-- Placeholder label -->
  <text x="600" y="635" text-anchor="middle" font-family="system-ui, sans-serif" font-size="23.625000000000004" font-weight="400" fill="#e2e8f0" opacity="0.5">
    Hero Image Placeholder
  </text>
  
  <!-- Ms V Lab watermark -->
  <text x="1160" y="645" text-anchor="end" font-family="system-ui, sans-serif" font-size="14.175000000000002" fill="#e2e8f0" opacity="0.15">
    Ms V Lab
  </text>
</svg>