<svg width="1200" height="675" viewBox="0 0 1200 675" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background gradient - studio lighting -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a"/>
      <stop offset="40%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#334155"/>
    </linearGradient>
    
    <!-- Floor reflection gradient -->
    <linearGradient id="floorGrad" x1="0%" y1="50%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#0f172a;stop-opacity:0"/>
    </linearGradient>
    
    <!-- Rim light gradient -->
    <radialGradient id="rimLight" cx="50%" cy="20%" r="60%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0"/>
    </radialGradient>
    
    <!-- Soft shadow filter -->
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="4" dy="8" stdDeviation="6" flood-color="#1e293b" flood-opacity="0.4"/>
    </filter>
    
    <!-- Glow filter -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    
    <!-- Subtle noise texture -->
    <filter id="noise" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch" result="noise"/>
      <feBlend in="SourceGraphic" in2="noise" mode="overlay"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bgGrad)"/>
  
  <!-- Rim light / key light simulation -->
  <ellipse cx="600" cy="101.25" rx="720" ry="202.5" fill="url(#rimLight)"/>
  
  <!-- Floor / surface reflection -->
  <rect x="0" y="371.25000000000006" width="1200" height="303.75" fill="url(#floorGrad)"/>
  
  <!-- Subtle vignette -->
  <rect width="1200" height="675" fill="none" stroke="#0f172a" stroke-width="360" opacity="0.3" filter="url(#noise)"/>
  
  
    <g transform="translate(600, 337) scale(1.1)">
      <!-- Screen -->
      <rect x="-100" y="-120" width="200" height="130" rx="4" fill="#1e293b" filter="url(#shadow)"/>
      <rect x="-92" y="-112" width="184" height="114" rx="2" fill="#0a0f1a"/>
      <!-- Screen content reflection -->
      <rect x="-92" y="-112" width="184" height="57" rx="2" fill="#3b82f6" opacity="0.05"/>
      <!-- Keyboard deck -->
      <rect x="-110" y="15" width="220" height="35" rx="4" fill="#1e293b" filter="url(#shadow)"/>
      <rect x="-100" y="20" width="200" height="25" rx="2" fill="#334155"/>
      <!-- Keys hint -->
      <rect x="-90" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-74" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-58" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-42" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-26" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-10" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="6" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="22" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="38" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="54" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="70" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="86" y="25" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-90" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-74" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-58" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-42" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-26" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-10" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="6" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="22" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="38" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="54" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="70" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="86" y="29" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-90" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-74" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-58" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-42" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-26" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-10" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="6" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="22" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="38" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="54" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="70" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="86" y="33" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-90" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-74" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-58" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-42" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-26" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-10" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="6" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="22" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="38" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="54" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="70" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="86" y="37" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-90" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-74" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-58" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-42" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-26" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="-10" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="6" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="22" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="38" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="54" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="70" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/><rect x="86" y="41" width="12" height="3" rx="1" fill="#1e293b" opacity="0.7"/>
      <!-- Trackpad -->
      <rect x="-30" y="55" width="60" height="40" rx="4" fill="#334155"/>
      <!-- Hinge -->
      <rect x="-10" y="10" width="20" height="8" rx="2" fill="#1e293b"/>
    </g>
  
  
  <!-- Category badge -->
  <rect x="40" y="40" width="140" height="36" rx="18" fill="#1e293b" opacity="0.8" filter="url(#shadow)"/>
  <text x="110" y="66" text-anchor="middle" font-family="system-ui, sans-serif" font-size="16.5375" font-weight="700" fill="#3b82f6" letter-spacing="0.5px">
    COMPUTING
  </text>
  
  <!-- Title (only for hero) -->
  
  <text x="600" y="595" text-anchor="middle" font-family="system-ui, sans-serif" font-size="37.125" font-weight="700" fill="#e2e8f0" filter="url(#shadow)">
    Samsung 990 Pro 2TB Review: PCIe 4.0 Speed King for PS5...
  </text>
  
  
  <!-- Placeholder label -->
  <text x="600" y="635" text-anchor="middle" font-family="system-ui, sans-serif" font-size="23.625000000000004" font-weight="400" fill="#e2e8f0" opacity="0.5">
    Hero Image Placeholder
  </text>
  
  <!-- Ms V Lab watermark -->
  <text x="1160" y="645" text-anchor="end" font-family="system-ui, sans-serif" font-size="14.175000000000002" fill="#e2e8f0" opacity="0.15">
    Ms V Lab
  </text>
</svg>